# Google Cloud Console > Google Auth Platform > Clients > Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ORIGIN=http://localhost:3000
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# Managed PostgreSQL connection string for production.
DATABASE_URL=
# Set to false only for a local PostgreSQL instance without TLS.
DATABASE_SSL=true
# Maximum connections per server instance.
DATABASE_POOL_MAX=10
# Base64 encoding of exactly 32 random bytes, used to encrypt Gmail tokens.
TOKEN_ENCRYPTION_KEY=
# Register this exact redirect URI on the OAuth client.
# http://localhost:3000/auth/callback
